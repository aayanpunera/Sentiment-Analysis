{
  "rewrites": [
    {
      "source": "/((?!static/|css/|js/|images/|favicon.ico).*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{models/**,templates/**,static/**,public/**,database/**}",
      "excludeFiles": "{dataset/**,tests/**,.venv/**,*.pyc,__pycache__/**}",
      "maxDuration": 30
    }
  }
}
